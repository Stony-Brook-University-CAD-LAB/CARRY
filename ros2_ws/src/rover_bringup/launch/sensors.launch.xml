<?xml version="1.0"?>
<launch>
  <!-- Mapping turns registration on and publishes depth in the colour frame. -->
  <arg name="depth_registration" default="false"/>
  <arg name="depth_frame" default="camera_depth_optical_frame"/>

  <set_env name="OPENNI2_REDIST" value="/opt/openni2-orbbec"/>

  <node pkg="rover_camera" exec="rgb_node" name="rgb_camera" output="screen">
    <param name="device" value="0"/>
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="fps" value="30"/>
    <param name="frame_id" value="camera_color_optical_frame"/>
  </node>

  <node pkg="rover_camera" exec="depth_node" name="depth_camera" output="screen">
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="fps" value="30"/>
    <param name="frame_id" value="$(var depth_frame)"/>
    <param name="depth_registration" value="$(var depth_registration)"/>
  </node>
</launch>
